{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "vitest.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "node_modules/@supabase/functions-js/src/edge-runtime.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/theme",
    "supabase"
  ]
}

